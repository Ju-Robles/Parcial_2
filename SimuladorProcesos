def cargar_procesos(): # para cargar procesos, no se si esta bien pero creo que va queriendo
    #aca se guardarian los procesos en una lista
    procesos = []
    #cantidad de procesos, se valida qe esten entre 1 y 4
    cantidad = leer_entero("Ingrese la cantidad de procesos a cargar (1 a 4): ")

    while cantidad < 1 or cantidad > 4:
        print("Por favor, ingrese un número entre 1 y 4.")
        cantidad = leer_entero("Ingrese la cantidad de procesos a cargar (1 a 4): ")
    #cargando los procesitos uno por uno
    for i in range(cantidad):
        print("Proceso P", i + 1,": ")
        #se pregunta en que unidad de tiempo llega el proceso, se valida que no sea negativo
        tiempo_llegada = leer_entero("Ingrese el tiempo de llegada: ")

        while tiempo_llegada < 0:
            print("El tiempo de llegada no puede ser negativo.")
            tiempo_llegada = leer_entero("Ingrese el tiempo de llegada: ")
        #se pregunta cuantas rafagas de cpu tiene el proceso, se valida que sea entre 1 y 4
        cantidad_rafagas = leer_entero("Ingrese la cantidad de ráfagas (1 a 4): ")

        while cantidad_rafagas < 1 or cantidad_rafagas > 4:
            print("Debe ingresar al menos 1 ráfaga y no más de 4.")
            cantidad_rafagas = leer_entero("Ingrese la cantidad de ráfagas (1 a 4): ")
        #lista que guarda las rafagas del proceso
        rafagas = []
        for j in range(cantidad_rafagas):
            tiempo_cpu = leer_entero(f"Ingrese la duración de la ráfaga {j + 1}: ")

            while tiempo_cpu < 0:
                print("La duración de la ráfaga no puede ser negativa.")
                tiempo_cpu = leer_entero(f"Ingrese la duración de la ráfaga {j + 1}: ")
            rafagas.append(tiempo_cpu)
        #diccionario de procesos pq python no tiene struct
        proceso = {
            'nombre': f"P{i + 1}",
            'tiempo_llegada': tiempo_llegada, #en cual unidad de tiempo entra el proceso al queue
            'rafagas_originales': rafagas, #ingresadas por el usuario
            #creo que deberiamos tambien hacer otra lista de rafagas pero que se consuma con el tiempo
            'rafagas': list(rafagas), #lista de rafagas que se consume a medida que se ejecuta el proceso
            'estado': 'Nuevo', #estado inicial del proceso (la idea es que se vaya atualizando)
            'tiempo_restante_bloqueo': 0, #tiempo restante de bloqueo para cuando salga a e/s, se inicializa en 0 pq no esta bloq al principio
         }
        #esto agrega el proceso a la lista de procesos 
        procesos.append(proceso)
        #devuelve la lista completa de procesos cargados
        return procesos

def mostrar_procesos(procesos): #para mostrar los procesos cargados, validar que existan en prmer lugar

    if not procesos:
        print("No hay procesos cargados. Cargue los procesos primero. \n")
        return
    else:
        print("|-----------------------------------|")
        print("|        PROCESOS CARGADOS          |")
        print("|-----------------------------------|")

        for proceso in procesos:
            print(f"Nombre: {proceso['nombre']}")
            print(f"Tiempo de llegada: {proceso['tiempo_llegada']}")
            print(f"Ráfagas de CPU: {proceso['rafagas']}")
            print("|-----------------------------------|")
    

def simular_ejecucion(procesos): #aca habia pensado en hacer un menu para elegir el algoritmo de planificacion
    #se valida que existan procesos antes de simular ejecucion
    if not procesos:
        print("No hay procesos cargados. Por favor, cargue los procesos primero.")
        return
    #menu para elegir el algoritmo de planificacion
    print("------------------------------------------")
    print("        ALGORITMO DE PLANIFICACION        ")
    print("------------------------------------------")
    print(" 1. FIFO (First In First Out)             ")
    print(" 2. SRTF (Mas corto primero con desalojo) ")
    print(" 3. Volver al menu principal              ")
    print("------------------------------------------")
    opcion_algoritmo = leer_entero("Seleccione un algoritmo de planificación: ") #guardamos la opcion del menu en la variable opcion_algoritmo

    if opcion_algoritmo == 1: #si es 1, se ejecuta FIFO
        fifo(procesos)
    elif opcion_algoritmo == 2: #si es 2, se ejecuta SRTF
        srtf(procesos)
    elif opcion_algoritmo == 3: #si es 3, se vuelve al menu principal
        return
    else:
        print("Opción inválida. Por favor, seleccione una opcion del menu.") #si no es ninguna, se dice q esta mal


def fifo(procesos): #fifito first in first out

    print("--------------------------------")
    print("     ALGORITMO SELECCIONADO:    ")
    print("               FIFO             ")
    print("--------------------------------")
    
    tiempo_actual = 0; #inicia en 0 porque es el principio we

    #listas para cada estado de los procesos
    listos = []
    bloqueados = []

    #estados del cpu
    proceso_ejecutandose = None;

    #bucle de iteracion madre
    while procesos or listos or bloqueados or proceso_ejecutandose > 0
        print("Tiempo {tiempo_actual} ut")

        #la prioridad es la carga asi que primero se chequea si uno quiere entrar
        procesos_nuevos = [p for p in procesos if p['tiempo_llegada'] == tiempo_actual]
        for p in procesos_nuevos:
            print(f"-> {p['nombre']} ha llegado a la cola.")
            p['estado'] = 'Listo'
            listos.append(p)
            procesos.remove(p)

        #cpu esta ocupado?
        if proceso_ejecutandose:
            rafaga_actual = proceso_ejecutandose['rafagas'][0]
            print(f"-> Ejecutando {proceso_ejecutandose['nombre']} (Rafaga restante: {rafaga_actual}ut)")

            #se resta el tiempo ejecutado. el s.o usa 10ut
            proceso_ejecutandose['rafagas'][0] -= 10

            #se verifica si ya termino la rafaga actual
            if proceso_ejecutandose['rafagas'][0] <= 0:
                proceso_ejecutandose['rafagas'].pop(0) #la respectiva rafaga se remueve del queue
                if not proceso_ejecutandose['rafagas']:
                    print(f"-> {proceso_ejecutandose['nombre']} ha sido TERMINADO.")
                else:
                    print(f"-> {proceso_ejecutandose['nombre']} se BLOQUEA porque requiere E/S (30ut)")
                    proceso_ejecutandose['estado'] = 'Bloqueado'
