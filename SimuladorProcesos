def cargar_procesos(): #funcion para edirle al usuario todos los datos de los procesos a simular
    #lista vacia para ir guardando cada proceso
    procesos = []

    #el usuario elige la cantidad de procesos
    cantidad = leer_entero("Ingrese la cantidad de procesos a cargar (1 a 4): ")

    #validamos con un while que sea entre 1 y 4 procesos
    while cantidad < 1 or cantidad > 4:
        print("Por favor, ingrese un número entre 1 y 4.")
        cantidad = leer_entero("Ingrese la cantidad de procesos a cargar (1 a 4): ")

    #cargando los procesitos uno por uno con un for
    for i in range(cantidad):
        print("Proceso P", i + 1,": ")

        #pedimos en que ut entra el proceso
        tiempo_llegada = leer_entero("Ingrese el tiempo de llegada: ")

        #validacion pq ademas de no ser negativo, el sistema solo avanza de 10 en 10
        while tiempo_llegada < 0 or tiempo_llegada % 10 != 0:
             print("El tiempo de llegada del proceso no puede ser negativo y debe ser un multiplo de 10.")
             tiempo_llegada = leer_entero("Ingrese el tiempo de llegada: ")

        #preguntamos cuantas rafagas de ejecucion va a tener cada proceso
        cantidad_rafagas = leer_entero("Ingrese la cantidad de ráfagas (1 a 4): ")

        #validamos que la cantidad de rafagas este dentro del rango
        while cantidad_rafagas < 1 or cantidad_rafagas > 4:
            print("Debe ingresar al menos 1 ráfaga y no más de 4.")
            cantidad_rafagas = leer_entero("Ingrese la cantidad de ráfagas (1 a 4): ")
        #lista que guarda las rafagas del proceso
        rafagas = []

        #otro bucle para pedir la duracion de las rafagas
        for j in range(cantidad_rafagas):
            tiempo_cpu = leer_entero(f"Ingrese la duración de la ráfaga {j + 1}: ")

            #validamos que la rafaga sea un multiplo de 10
            while tiempo_cpu <= 0 or tiempo_cpu % 10 != 0:
                print("La duracion de la rafaga debe ser mayor a 0 y multiplo de 10.")
                tiempo_cpu = leer_entero(f"Ingrese la duración de la ráfaga {j + 1}: ")
            
            #si pasa a validacion se agrega la duracion de la rafaga a la lista
            rafagas.append(tiempo_cpu)

        #diccionario de procesos pq python no tiene struct
        proceso = {
            'nombre': f"P{i + 1}",
            'tiempo_llegada': tiempo_llegada, #en cual unidad de tiempo entra el proceso al queue
            'rafagas_originales': rafagas, #rafagas originales ingresadas por el usuario
            'rafagas': list(rafagas), #lista de rafagas que se consume a medida que se ejecuta el proceso
            'estado': 'Nuevo', #estado inicial del proceso (la idea es que se vaya atualizando)
            'tiempo_restante_bloqueo': 0, #tiempo restante de bloqueo para cuando salga a e/s, se inicializa en 0 pq no esta bloq al principio
         }
        
        #esto agrega el proceso a la lista de procesos
        #append manda al final de la lista al proceso que vaya a entrar
        procesos.append(proceso)

     #devuelve la lista completa de procesos cargados
    return procesos

