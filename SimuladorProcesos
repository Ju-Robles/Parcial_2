def simular_ejecucion(procesos): #submenu para elegir el algoritmo de planificacion
    #validamos que primero haya algo cargado
    if not procesos:
        print("No hay procesos cargados. Por favor, cargue los procesos primero.")
        return
    
    #menu para elegir el algoritmo de planificacion
    print("------------------------------------------")
    print("        ALGORITMO DE PLANIFICACION        ")
    print("------------------------------------------")
    print(" 1. FIFO (First In First Out)             ")
    print(" 2. SRTF (Mas corto primero con desalojo) ")
    print(" 3. Volver al menu principal              ")
    print("------------------------------------------")

    #guardamos que algoritmo eligio el user
    opcion_algoritmo = leer_entero("Seleccione un algoritmo de planificación: ") #guardamos la opcion del menu en la variable opcion_algoritmo

    #segun la opcion llamamos a la funcion del algoritmo correspondiente
    if opcion_algoritmo == 1: #si es 1, se ejecuta FIFO
        fifo(procesos)
    elif opcion_algoritmo == 2: #si es 2, se ejecuta SRTF
        srtf(procesos)
    elif opcion_algoritmo == 3: #si es 3, se vuelve al menu principal
        return
    else:
        print("Opción inválida. Por favor, seleccione una opcion del menu.") #si no es ninguna, se dice q esta mal

#funcion para armar una copia limpia desde 0 antes de cada simulacion
def copiar_procesos(procesos_originales):
    # Crea una copia limpia de los procesos para no borrar los datos originales al simular
    copia = []
    for p in procesos_originales:
        copia.append({
            'nombre': p['nombre'],
            'tiempo_llegada': p['tiempo_llegada'],
            'rafagas_originales': list(p['rafagas_originales']),
            #se reinician las rafagas copiando los valores de rafagas originales
            'rafagas': list(p['rafagas_originales']),
            'estado': 'Nuevo',
            'tiempo_bloqueo_restante': 0
        })
    return copia


def fifo(procesos_originales): #fifito first in first out

#se muestra el algoritmo que fue seleccionado
    print("--------------------------------")
    print("     ALGORITMO SELECCIONADO:    ")
    print("               FIFO             ")
    print("--------------------------------")

    #trabajamos con la copia para no alterar los datos originales
    procesos = copiar_procesos(procesos_originales)

    #guardamos solo los nombres en otra lista para poder mostrarlos en el diagrama
    nombres_procesos = [p['nombre'] for p in procesos]

    #guardamos que paso en cada unidad de tiempo
    historial = []
    
    tiempo_actual = 0; #inicia en 0 porque es el principio 

    #listas para cada estado de los procesos
    en_espera = []
    listos = []
    bloqueados = []

    #estados del cpu 
    proceso_ejecutandose = None;

    #bucle de iteracion madre
    while procesos or en_espera or listos or bloqueados or proceso_ejecutandose:
        #se muestra el tiempo actual en el que se encuentra el s.o
        print(f"Tiempo {tiempo_actual} ut")

        #variables para anotar que hizo el SO y quien uso la CPU
        accion_so = ""
        cpu_actual = ""

        #vemos que procesos de la lista original tienen un tiempo de llegada menor o igual al reloj 
        procesos_nuevos = [p for p in procesos if p['tiempo_llegada'] <= tiempo_actual]
        for p in procesos_nuevos:
            en_espera.append(p) #los ponemos para que el SO los cargue
            procesos.remove(p) #los sacamos de pendientes para no volver a meterlos

        # Guardamos foto de bloqueados al inicio de estas 10ut para la tabla
        bloq_foto = [p['nombre'] for p in bloqueados]

        #los procesos que están bloqueados haciendo E/S les descontamos 10 UT de su espera
        for p in bloqueados:
            if p['tiempo_bloqueo_restante'] > 0:
                p['tiempo_bloqueo_restante'] -= 10

        #en una lista auxiliar vemos cuales procesos cumplieron sus 30ut
        bloq_terminados = [p for p in bloqueados if p['tiempo_bloqueo_restante'] <= 0]

        #si el proceso en la cpu justo termino su rafga
        if proceso_ejecutandose and proceso_ejecutandose['rafagas'][0] <= 0:
            #eliminamos esa rafaga usando pop(0)
            proceso_ejecutandose['rafagas'].pop(0)

            #si la lista esta vacia significa que el proceso termino
            if not proceso_ejecutandose['rafagas']:
                print(f" -> S.O. finaliza a {proceso_ejecutandose['nombre']} (Termino su ejecucion).")
                accion_so = f"6{proceso_ejecutandose['nombre']}"
            else:
                #si quedan mas rafagas es porque necesita entrada salida ou yeah
                print(f"-> S.O. envía a {proceso_ejecutandose['nombre']} a Bloqueado por E/S (30ut)")
                accion_so = f"3{proceso_ejecutandose['nombre']}"
                proceso_ejecutandose['estado'] = 'Bloqueado'
                proceso_ejecutandose['tiempo_bloqueo_restante'] = 30
                #se agrega a la blocked list por necesitar e/s
                bloqueados.append(proceso_ejecutandose)

            #LIBERAMOS A LA CPU asi puede recibir otro procesito
            proceso_ejecutandose = None

        #si la CPU esta libre el S.O aprovecha para ejecutar una politica
        elif not proceso_ejecutandose:
            if en_espera: #la prioridad es la carga
            #pop funciona perfecto para fifo ya que sirve para sacar y devolver el primer elemento de una lista
                p = en_espera.pop(0) #sacamos al primero que estaba intentando entrar
                print(f"-> S.O. carga a {p['nombre']}. Esta Listo para ejecutar.")
                accion_so = f"1{p['nombre']}" #carga proceso nuevo
                p['estado'] = 'Listo'
                listos.append(p)

                #si un proceso termino su e/s lo manda a listos
            elif bloq_terminados:
                p = bloq_terminados[0]
                print(f"-> {p['nombre']} ha finalizado su E/S. pasa a Listo.")
                accion_so = f"4{p['nombre']}"
                p['estado'] = 'Listo'
                bloqueados.remove(p)
                listos.append(p)
                #si hay proceso en cola de listos despaha al primero a la CPU
            elif listos:
                #FIFO (First in First Out) saca el primero de la cola
                proceso_ejecutandose = listos.pop(0)
                proceso_ejecutandose['estado'] = 'Ejecutando'
                accion_so = f"2{proceso_ejecutandose['nombre']}"
                print(f"-> S.O. despacha a {proceso_ejecutandose['nombre']} a la CPU.")
            else:
                #si no hay procesos listos la CPU esta de vacation ou yea
                print("-> La CPU no esta ejecutando un proceso actualmente.")

        #si hay un proceso y aun le queda rafaga actual:
        else:
            rafaga_actual = proceso_ejecutandose['rafagas'][0]
            print(f"-> Ejecutando {proceso_ejecutandose['nombre']} (Rafaga restante: {rafaga_actual}ut)")
            cpu_actual = proceso_ejecutandose['nombre'] #anotamos que este proceso uso la cpu en esta iteracion
            proceso_ejecutandose['rafagas'][0] -= 10 #le restamos las 10ut que acaba de ejecutar

        #Se avanzan las 10ut para el siguiente bucleeeeeeee
        tiempo_actual += 10

        #guardamos en el hisyorial tdos los datos de esta vuelta asi los usa el diagrama
        historial.append({
            'tiempo': tiempo_actual,
            'so':accion_so,
            'cpu': cpu_actual,
            'listos': [p['nombre'] for p in listos], #solo guarda los nombres de los que estan listos
            'bloqueados': bloq_foto
        })

#ya terminado el bucle es porque ya no queda ningun proceso
    print("-----------------------------------")
    print("        FIN DE LA SIMULACION       ")
    print("-----------------------------------")
    print(f"-> La simulacion duro hasta {tiempo_actual}ut ")
    print("-----------------------------------")
    print("\n")

    #se llama a la funcion que dibuja la tabla pasandole todo lo que se guardo en el historial 
    imprimir_diagrama(historial, nombres_procesos)


def srtf(procesos_originales): #mas cortito primero CON DESALOJO
    print("--------------------------------")
    print("     ALGORITMO SELECCIONADO:    ")
    print(" MAS CORTO PRIMERO CON DESALOJO ")
    print("--------------------------------")

    #copiamos los procesos para no perder los datos originales
    procesos = copiar_procesos(procesos_originales)
    # Guardamos los nombres d los procesos para mostrarlos en la tabla después
    nombres_procesos = [p['nombre'] for p in procesos]
    historial = []

    tiempo_actual=0; #lo empezamos en 0 

    #listas de los estados de los procesos (vacias)
    en_espera = []
    listos=[]
    bloqueados=[]

    #estados del cpu 
    proceso_ejecutandose=None

    #bucle madre de iteracion
    while procesos or en_espera or listos or bloqueados or proceso_ejecutandose:
        #se muestra el tiempo actual del sistema operativo
        print(f"Tiempo {tiempo_actual} ut")

        accion_so = ""
        cpu_actual = ""

        #revisamos si un proceso nuevo entra en este instante de tiempo
        procesos_nuevos = [p for p in procesos if p['tiempo_llegada'] <= tiempo_actual]
        for p in procesos_nuevos:
            en_espera.append(p)
            procesos.remove(p)

        #foto de los bloq al inicio del turno para mostrar en el diagrama
        bloq_foto = [p['nombre'] for p in bloqueados]

        #descontamos 10ut a los procesos que estan esperando e/s
        for p in bloqueados:
            if p['tiempo_bloqueo_restante'] > 0:
                p['tiempo_bloqueo_restante'] -= 10

        #vemos cuales terminaron su tiempo de bloqueo
        bloq_terminados = [p for p in bloqueados if p['tiempo_bloqueo_restante'] <= 0]

        #si el proceso que esta en CPU ua termino toda su rafaga actual
        if proceso_ejecutandose and proceso_ejecutandose['rafagas'][0] <= 0:
            proceso_ejecutandose['rafagas'].pop(0) #sacamos la rafaga terminada

            if not proceso_ejecutandose['rafagas']:
                print(f" -> S.O. finaliza a {proceso_ejecutandose['nombre']} (Termino su ejecucion).")
                accion_so = f"6{proceso_ejecutandose['nombre']}"
            else:
                #si quedan ráfagas es pq necesita entrada salida
                print(f"-> S.O. envía a {proceso_ejecutandose['nombre']} a Bloqueado por E/S (30ut)")
                accion_so = f"3{proceso_ejecutandose['nombre']}"
                proceso_ejecutandose['estado'] = 'Bloqueado'
                proceso_ejecutandose['tiempo_bloqueo_restante'] = 30
                bloqueados.append(proceso_ejecutandose)

            proceso_ejecutandose = None #liberamos la CPU

        #si hay procesos q recien llegan esperando, el SO los carga a la cola de listos
        elif en_espera:
            p = en_espera.pop(0)
            print(f"-> S.O. carga a {p['nombre']}. Esta Listo para ejecutar.")
            accion_so = f"1{p['nombre']}"
            p['estado'] = 'Listo'
            listos.append(p)

        #si algun proceso termino su E/s, el SO lo devuelve a listo
        elif bloq_terminados:
            p = bloq_terminados[0]
            print(f"-> {p['nombre']} ha finalizado su E/S. S.O. lo pasa a Listo.")
            accion_so = f"4{p['nombre']}"
            p['estado'] = 'Listo'
            bloqueados.remove(p)
            listos.append(p)

        #Logica del mas corto primero con desalojo
        else:
            #lista para pasar a toditos los candidatos de listo a ser mas corto primero
            candidatos = listos.copy()

            #si hay uno ejecutandose, lo ponemos al principio para que en caso de empate lo priorice en vez de desalojar
            if proceso_ejecutandose:
                candidatos.insert(0, proceso_ejecutandose)

            if candidatos:
                #min funciona para buscar el más chico y con el key podemos hacer la busqueda mas exacta para q no se quede buscando y buscando 
                mas_corto = min(candidatos, key=lambda x: x['rafagas'][0])

                #si el mas corto es el mismo que ya estaba en la CPU, sigue su ejecucion
                if mas_corto == proceso_ejecutandose:
                    rafaga_actual = proceso_ejecutandose['rafagas'][0]
                    print(f"-> Ejecutando {proceso_ejecutandose['nombre']} (Rafaga restante: {rafaga_actual}ut)")
                    cpu_actual = proceso_ejecutandose['nombre']
                    proceso_ejecutandose['rafagas'][0] -= 10
                else:
                    #si habia un proceso en la CPU pero aparecio uno mas corto en la cola de Listos, el SO desaloja
                    if proceso_ejecutandose is not None:
                        print(f"-> S.O. desaloja a {proceso_ejecutandose['nombre']} porque {mas_corto['nombre']} es más corto.")
                        accion_so = f"5{proceso_ejecutandose['nombre']}"
                        proceso_ejecutandose['estado'] = 'Listo'
                        #el proceso desalojado vuelve a Listo y liberamos el procesador
                        listos.append(proceso_ejecutandose)
                        proceso_ejecutandose = None
                    else:
                        #si la cpu estaba ociosa, directamente ejecutamos al mas corto que encontramos
                        proceso_ejecutandose= mas_corto
                        #lo sacamos de la cola de listos para que no quede duplicado
                        listos.remove(mas_corto)
                        proceso_ejecutandose['estado'] = 'Ejecutando'
                        accion_so = f"2{proceso_ejecutandose['nombre']}"
                        print(f"-> S.O. desaloja/ejecuta a {proceso_ejecutandose['nombre']}.")    

        # sumamos las 10ut de la iteracion
        tiempo_actual += 10

        #guardamos los datos de la simulacion en el historial
        historial.append({
            'tiempo': tiempo_actual,
            'so': accion_so,
            'cpu': cpu_actual,
            'listos': [p['nombre'] for p in listos],
            'bloqueados': bloq_foto
        })

    print("-----------------------------------")
    print("        FIN DE LA SIMULACION       ")
    print("-----------------------------------")
    print(f"-> La simulacion duro hasta {tiempo_actual}ut ")
    print("-----------------------------------")
    print("\n")

    #imprimimos la tabla con los resultados de MCP/D
    imprimir_diagrama(historial, nombres_procesos)
            
#funcion para mostrar por consola la tabla tiempo/proceso tipo excel
def imprimir_diagrama(historial, nombres_procesos): 
    if not historial:
        print("No hay procesos cargados.")
        return
    else:
        print("\n|----------------------------------------------------|")
        print("|             DIAGRAMA TIEMPO / PROCESO              |")
        print("|----------------------------------------------------|")
        print("Referencias S.O.: 1=Carga | 2=Ejecucion | 3=Bloqueo | 4=Fin E/S | 5=Desalojo | 6=Fin\n")

        #cortamos la simulacion en en bloques de 12 columnas porque puede ser muy larga
        columnas_por_bloque = 12

        #el tercer parametro de range hace que el inicio salte de 12 en 12
        for inicio in range(0, len(historial), columnas_por_bloque):
            #recortamos una slice de 12 elementos del historial de hasta 12 elementos
            bloque = historial[inicio:inicio + columnas_por_bloque]

            #calculamos el largo del renglon de los guiones segun las columnas del bloque
            separador = "-" * (14 + len(bloque) * 6)
            print(separador)

            #las filas de bloqueo las recorremos de atras para adelante para que se apilen de abajo hacia arriba
            for i in range(len(nombres_procesos) - 1, -1, -1):
                #ponemos la palabra bloqueo en la fila
                titulo = "Bloqueo" if i == len(nombres_procesos) // 2 else ""
                #el <10 alinea el texto a la izquierda ocupando siempre 10 espacios fijos
                fila = f"| {titulo:<10} |"
                for paso in bloque:
                    #si en ese momento habia un proceso en esa posicion de la cola de bloqueados, se muestra
                    celda = paso['bloqueados'][i] if i < len(paso['bloqueados']) else ""
                    #el ^5 centra el texto de la celda en 5 espacios para que coincida toda la grilla
                    fila += f"{celda:^5}|"
                print(fila)
            print(separador)

            
            #las filas de ejecucion de la CPU reccoren todos los procesos al reves y ponemos una X si usan la CPU
           # reversed sirve para invertir el orden de una lista o secuencia al momento de recorrerla, sin modificar la lista original
            for nombre in reversed(nombres_procesos):
                fila = f"| {nombre:^10} |"
                for paso in bloque:
                    celda = "X" if paso['cpu'] == nombre else ""
                    fila += f"{celda:^5}|"
                print(fila)
                print(separador)

            #igual que bloqueo, se dibuja como una pila de abajo hacia arriba
            for i in range(len(nombres_procesos) - 1, -1, -1):
                titulo = "Listo" if i == len(nombres_procesos) // 2 else ""
                fila = f"| {titulo:<10} |"
                for paso in bloque:
                    celda = paso['listos'][i] if i < len(paso['listos']) else ""
                    fila += f"{celda:^5}|"
                print(fila)
            print(separador)

            #fila de acciones del SO, muestra los codigos de la politica que este empleando
            fila_so = f"| {'S.O.':^10} |"
            for paso in bloque:
                fila_so += f"{paso['so']:^5}|"
            print(fila_so)
            print(separador)

            #fila inferior que contiene las unidades de tiempo
            fila_ut = f"| {'Tiempo UT':^10} |"
            for paso in bloque:
                fila_ut += f"{paso['tiempo']:^5}|"
            print(fila_ut)
            print(separador + "\n")


#funcion principal que coordina todo el programa
def main():
    #lista para guardar procesos en el main
    procesos = []

    #bucle infinito para que el menu aparezca hasta que el usuario quiera salir
    while True:
        opcion = menu() #mostramos el menu y guardamos la opcion del user

        if opcion == 1:
            #cargando los procesos y guardandolos en la lista que devuelve
            procesos = cargar_procesos()
            print("Los procesos han sido cargados exitosamente.")
        elif opcion == 2:
            #mle pasamos la lista de procesos para imprimir en pantalla
            mostrar_procesos(procesos)
        elif opcion == 3:
            #abre el submenu para elegir la politica de planificacion
            simular_ejecucion(procesos)
        elif opcion == 4:
            print("Gracias por usar el programa!")
            break #rompe el while True y termina la ejecucion
        else:
            #si puso una opcion que no esta en el menu, le pedimos al user reintentar
            print("Opción inválida. Por favor, seleccione una opción del menu.")

if __name__ == "__main__":
     main()
