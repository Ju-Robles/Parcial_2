def main():
    #lista para guardar procesos en el main
    procesos = []

    while True:
        opcion = menu() #se guarda la opcion del menu en la variable opcion 

        if opcion == 1:
            #cargando los procesos y guardandolos en la lista de procesos con la funcion cargar_procesos
            procesos = cargar_procesos()
            print("Los procesos han sido cargados exitosamente.")
        elif opcion == 2:
            #muestra los procesos cargados y sus respectivos detalles
            mostrar_procesos(procesos)
        elif opcion == 3:
            #abre el menu que permite seleccionar el algoritmo de planificacion
            simular_ejecucion(procesos)
        elif opcion == 4:
            print("Gracias por usar el programa!")
            break
        else:
            print("Opción inválida. Por favor, seleccione una opción del menu.")

if __name__ == "__main__":
     main()
