                rafagas.append("CPU: ", (tiempo_cpu))
#diccionario de procesos pq python no tiene struct
            proceso = {
                'nombre': f"P{i + 1}",
                'tiempo_llegada': tiempo_llegada,
                'rafagas': rafagas
            }
#esto agrega el proceso a la lista de procesos 
            procesos.append(proceso)
#devuelve la lista completa de procesos cargados
        return procesos

